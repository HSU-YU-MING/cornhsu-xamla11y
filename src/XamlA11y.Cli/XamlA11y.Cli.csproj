<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XamlA11y.Cli</RootNamespace>
    <AssemblyName>xamla11y</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xamla11y</ToolCommandName>
    <PackageId>Cornhsu.XamlA11y</PackageId>
    <!-- ⚠ tag 才是版本真相源；不要改成真版號，也不要刪掉這一格。 -->
    <Version>0.0.0-dev</Version>
    <Description>XamlA11y — static accessibility audit for WPF XAML. Finds controls a screen reader cannot name and things a keyboard cannot reach without launching the app, and fails CI on new ones.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XamlA11y.Core\XamlA11y.Core.csproj" />
  </ItemGroup>
</Project>

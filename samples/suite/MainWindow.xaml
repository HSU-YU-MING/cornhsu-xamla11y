<Window x:Class="Suite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Suite.Resources"
        Title="{x:Static p:Strings.Title}" Width="420" Height="300" FontFamily="XamlFit Demo Sans"
        Background="{StaticResource PaperBrush}" Foreground="{StaticResource TextBrush}">

    <!-- One problem for each of the four tools, on purpose (see docs/four-tools.md) -->
    <StackPanel Margin="16">
        <!-- XamlContrast: light grey on white -->
        <TextBlock Text="{x:Static p:Strings.Hint}" Foreground="{StaticResource HintBrush}"/>

        <!-- XamlKeys: the key does not exist -->
        <TextBlock Text="{x:Static p:Strings.Title}" Foreground="{StaticResource TitleBrush}"/>

        <!-- XamlFit: the German text is wider than 60 -->
        <TextBlock Text="{x:Static p:Strings.Save}" Width="60" TextWrapping="NoWrap"/>

        <!-- XamlA11y: no accessible name -->
        <Button ToolTip="{x:Static p:Strings.Save}" Click="OnSave">
            <Path Data="M0,0 L8,8 L0,8 Z" Fill="{StaticResource TextBrush}"/>
        </Button>

        <!-- Fine for all four -->
        <Button Content="{x:Static p:Strings.Save}" Width="200" Foreground="Black" Background="White"/>

        <!-- Ignore comments stack: xamla11y-ignore first, the other tool's comment next to the element -->
        <!-- xamla11y-ignore: the text above is the accessible way to open it -->
        <!-- xamlcontrast-ignore: decorative -->
        <TextBlock Text="»" Foreground="#DDDDDD" MouseLeftButtonUp="OnOpen"/>
    </StackPanel>
</Window>

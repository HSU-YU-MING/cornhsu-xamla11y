<Project Sdk="Microsoft.NET.Sdk">
  <!-- 真值來源：把同一段 XAML 開成真的 WPF 視窗，讀 UI Automation 樹、走 Tab、跑 Axe-Windows。Windows only，不進 slnx、不發佈。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OracleTfm)' != ''">$(OracleTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>uiaoracle</AssemblyName>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/XamlA11y.Core/XamlA11y.Core.csproj" />
    <PackageReference Include="Axe.Windows" Version="2.4.2" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <None Include="facts/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
